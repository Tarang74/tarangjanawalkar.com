---
import "./Footer.scss";
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-sections">
      <div class="footer-section">
        <div class="footer-section-title">Contact</div>
        <div class="footer-section-links">
          <a
            href="mailto:contact@tarangjanawalkar.com"
            class="footer-section-link"
          >
            contact@&#8203;tarangjanawalkar.com
          </a>
        </div>
      </div>

      <div class="footer-section">
        <div class="footer-section-title">Socials</div>
        <div class="footer-section-links">
          <a
            href="https://linkedin.com/in/tarang-janawalkar"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-section-link"
          >
            LinkedIn
          </a>
          <a
            href="https://github.com/Tarang74"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-section-link"
          >
            GitHub
          </a>
          <a
            href="https://orcid.org/0000-0002-1535-4931"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-section-link"
          >
            ORCID
          </a>
        </div>
      </div>
    </div>
    <div class="rule"></div>
    <div class="footer-copyright">
      © {new Date().getFullYear()} Tarang Janawalkar. All rights reserved.
    </div>
  </div>
</footer>
