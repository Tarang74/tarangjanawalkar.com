---
import "./ScrollIndicator.scss";

const sections = [
  { id: "hero", label: "Home" },
  {
    id: "education",
    label: "Education",
    subsections: [
      { id: "phd", label: "PhD" },
      { id: "engineering", label: "Engineering" },
      { id: "mathematics", label: "Mathematics" },
    ],
  },
  {
    id: "projects",
    label: "Projects",
    subsections: [
      { id: "project-0", label: "OsteonX" },
      { id: "project-1", label: "Cellular Automata" },
      { id: "project-2", label: "QUT Notes" },
      { id: "project-3", label: "CAB202" },
      { id: "project-4", label: "The Sway" },
      { id: "project-5", label: "Water Waves" },
      { id: "project-6", label: "LaTeX" },
    ],
  },
];
---

<nav class="scroll-indicator" aria-label="Page navigation">
  <ul class="scroll-indicator-list">
    {
      sections.map((section) => (
        <li class="scroll-indicator-item" data-section={section.id}>
          <button
            class="scroll-indicator-button"
            data-target={section.id}
            aria-label={`Navigate to ${section.label}`}
          >
            <span class="scroll-indicator-label">{section.label}</span>
            <span class="scroll-indicator-dot" />
          </button>
          {section.subsections && (
            <ul class="scroll-indicator-subsections">
              {section.subsections.map((subsection) => (
                <li class="scroll-indicator-subitem">
                  <button
                    class="scroll-indicator-subbutton"
                    data-target={subsection.id}
                    aria-label={`Navigate to ${subsection.label}`}
                  >
                    <span class="scroll-indicator-subdot" />
                    <span class="scroll-indicator-sublabel">
                      {subsection.label}
                    </span>
                  </button>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>
</nav>

<script is:inline>
  function initScrollIndicator() {
    const buttons = document.querySelectorAll(
      ".scroll-indicator-button, .scroll-indicator-subbutton",
    );
    const items = document.querySelectorAll(".scroll-indicator-item");

    // Handle click navigation
    buttons.forEach(function (button) {
      button.addEventListener("click", function () {
        const target = button.getAttribute("data-target");
        let element = null;

        if (target === "hero") {
          element = document.querySelector(".hero-container");
        } else if (target === "education") {
          element = document.querySelector(".education-container");
        } else if (target === "projects") {
          element = document.querySelector(".projects-heading-container");
        } else if (target && target.indexOf("project-") === 0) {
          const index = parseInt(target.split("-")[1]);
          const projectItems = document.querySelectorAll(".project-item");
          element = projectItems[index];
        } else if (
          target === "phd" ||
          target === "engineering" ||
          target === "mathematics"
        ) {
          element = document.getElementById(target);
        }

        if (element) {
          element.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      });
    });

    // Update active state on scroll
    function updateActiveState() {
      const scrollY = window.scrollY;
      const vh = window.innerHeight;

      // Determine active section
      items.forEach(function (item) {
        const sectionId = item.getAttribute("data-section");
        let element = null;

        if (sectionId === "hero") {
          element = document.querySelector(".hero-container");
        } else if (sectionId === "education") {
          element = document.querySelector(".education-container");
        } else if (sectionId === "projects") {
          element = document.querySelector(".projects-heading-container");
        }

        if (element) {
          const rect = element.getBoundingClientRect();
          const elementTop = rect.top + scrollY;
          const elementBottom = elementTop + rect.height;

          // Check if in view
          if (
            scrollY >= elementTop - vh / 2 &&
            scrollY < elementBottom - vh / 2
          ) {
            item.classList.add("active");

            // Expand subsections if in education or projects
            if (sectionId === "education" || sectionId === "projects") {
              const subsections = item.querySelector(
                ".scroll-indicator-subsections",
              );
              if (subsections) {
                subsections.style.maxHeight = subsections.scrollHeight + "px";
              }
            }
          } else {
            item.classList.remove("active");

            // Collapse subsections
            const subsections = item.querySelector(
              ".scroll-indicator-subsections",
            );
            if (subsections) {
              subsections.style.maxHeight = "0";
            }
          }
        }
      });
    }

    let ticking = false;
    window.addEventListener(
      "scroll",
      function () {
        if (!ticking) {
          window.requestAnimationFrame(function () {
            updateActiveState();
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true },
    );

    updateActiveState();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initScrollIndicator);
  } else {
    initScrollIndicator();
  }
</script>
