---
import "./Squares.scss";
---

<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
  crossorigin="anonymous"
/>

<div class="squares"></div>

<script
  src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"
  crossorigin="anonymous"></script>
<script>
  let seed = Date.now();
  function random() {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  }

  // Use larger squares on mobile for better performance
  const isMobile = window.innerWidth < 768;
  const SQUARE_SIZE = isMobile ? 60 : 40;
  const latexSymbols = [
    "x",
    "y",
    "z",
    "\\mathbf{u}",
    "\\mathbf{v}",
    "\\mathbf{w}",
    "\\mathbf{i}",
    "\\mathbf{j}",
    "\\mathbf{k}",
    "\\alpha",
    "\\beta",
    "\\gamma",
    "\\delta",
    "\\epsilon",
    "\\varepsilon",
    "\\zeta",
    "\\eta",
    "\\theta",
    "\\vartheta",
    "\\iota",
    "\\kappa",
    "\\lambda",
    "\\mu",
    "\\nu",
    "\\xi",
    "\\pi",
    "\\varpi",
    "\\rho",
    "\\varrho",
    "\\sigma",
    "\\varsigma",
    "\\tau",
    "\\upsilon",
    "\\phi",
    "\\varphi",
    "\\chi",
    "\\psi",
    "\\omega",
    "\\Gamma",
    "\\Delta",
    "\\Theta",
    "\\Lambda",
    "\\Xi",
    "\\Pi",
    "\\Sigma",
    "\\Upsilon",
    "\\Phi",
    "\\Psi",
    "\\Omega",
    "+",
    "-",
    "\\times",
    "=",
    "\\neq",
    "\\approx",
    "\\lt",
    "\\gt",
    "\\leqslant",
    "\\geqslant",
    "\\infty",
    "\\partial",
    "\\nabla",
    "\\cdot",
    "\\int",
    "\\oint",
    "\\sum",
    "\\prod",
    "\\forall",
    "\\exists",
    "\\neg",
    "\\wedge",
    "\\vee",
  ];

  function getRandomSymbol() {
    return latexSymbols[Math.floor(random() * latexSymbols.length)];
  }

  function renderLatex(element, latex) {
    try {
      if (window.katex) {
        window.katex.render(latex, element, {
          throwOnError: false,
          displayMode: false,
        });
      }
    } catch {
      element.textContent = latex;
    }
  }

  function generateSquares() {
    const containers = document.getElementsByClassName("squares");

    for (let i = 0; i < containers.length; i++) {
      const container = containers[i];
      container.innerHTML = "";

      const containerWidth = container.offsetWidth;
      const containerHeight = container.offsetHeight;

      if (containerWidth === 0 || containerHeight === 0) continue;

      const cols = Math.ceil(containerWidth / SQUARE_SIZE);
      const rows = Math.ceil(containerHeight / SQUARE_SIZE);

      for (let row = 0; row < rows; row++) {
        for (let col = 0; col < cols; col++) {
          const square = document.createElement("div");
          square.className = "square";
          renderLatex(square, getRandomSymbol());
          container.appendChild(square);
        }
      }

      container.style.display = "grid";
      container.style.gridTemplateColumns = `repeat(${cols}, ${SQUARE_SIZE}px)`;
      container.style.gridTemplateRows = `repeat(${rows}, ${SQUARE_SIZE}px)`;
    }
  }

  function animateSquares() {
    const allSquares = document.querySelectorAll(".square");
    if (allSquares.length === 0) return;

    // Update 3-5 random squares every interval
    const numToUpdate = Math.floor(random() * 3) + 3;

    for (let i = 0; i < numToUpdate; i++) {
      const randomIndex = Math.floor(random() * allSquares.length);
      const square = allSquares[randomIndex];
      renderLatex(square, getRandomSymbol());
    }
  }
  document.addEventListener("DOMContentLoaded", () => {
    generateSquares();
    // Start animation after initial render
    setInterval(animateSquares, 400);
  });

  window.addEventListener("resize", generateSquares);
</script>
