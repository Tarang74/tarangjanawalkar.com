---
import "./Education.scss";
import Squares from "./Squares.astro";
---

<div class="education-container">
  <div class="education-background">
    <Squares />
  </div>

  <div class="education-content">
    <h2 class="education-heading">Education</h2>

    <div class="education-items">
      <div class="education-item">
        <div class="education-header">
          <div>
            <h3 class="education-degree">Doctor of Philosophy (Mathematics)</h3>
          </div>
        </div>
        <p class="education-institution">Queensland University of Technology</p>
        <div class="education-details">
          <p class="education-detail-item">
            <span class="education-label">Project:</span>
            <span class="education-value"
              >Exponential asymptotics for dispersive wave problems</span
            >
          </p>
          <p class="education-detail-item">
            <span class="education-label">Supervisors:</span>
            <span class="education-value"
              >Professor Scott McCue and Dr Michael Dallaston</span
            >
          </p>
        </div>
      </div>

      <div class="education-timeline-year">2025</div>

      <div class="education-item">
        <div class="education-header">
          <div>
            <h3 class="education-degree">Bachelor of Engineering (Honours)</h3>
            <p class="education-major">Computer and Software Systems</p>
          </div>
        </div>
        <p class="education-institution">Queensland University of Technology</p>
        <div class="education-details">
          <p class="education-detail-item">
            <span class="education-label">Honours Division:</span>
            <span class="education-value">First Class (91%)</span>
          </p>
          <div class="education-detail-item">
            <span class="education-label">Awards:</span>
            <ul class="education-awards-list">
              <li>QUT University Medal recipient</li>
              <li>Faculty of Engineering Dean's Scholar</li>
              <li>Dean's List across 10 semesters</li>
            </ul>
          </div>
          <div class="education-detail-item">
            <span class="education-label">Clubs:</span>
            <ul class="education-awards-list">
              <li>QUT Motorsport</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="education-item">
        <div class="education-header">
          <div>
            <h3 class="education-degree">Bachelor of Mathematics</h3>
            <p class="education-major">Applied & Computational</p>
          </div>
        </div>
        <p class="education-institution">Queensland University of Technology</p>
        <div class="education-details">
          <p class="education-detail-item">
            <span class="education-label">Grade Point Average:</span>
            <span class="education-value">High Distinction (96%)</span>
          </p>
          <div class="education-detail-item">
            <span class="education-label">Awards:</span>
            <ul class="education-awards-list">
              <li>QUT University Medal recipient</li>
              <li>Faculty of Science Dean's Scholar</li>
              <li>Dean's List across 10 semesters</li>
            </ul>
          </div>
          <div class="education-detail-item">
            <span class="education-label">Clubs:</span>
            <ul class="education-awards-list">
              <li>QUT Mathematics Society</li>
              <li>QUT College of Excellence</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="education-timeline-year">2021</div>
    </div>
  </div>
</div>
