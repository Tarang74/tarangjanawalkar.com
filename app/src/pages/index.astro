---
import "../styles/global.scss";
import Hero from "../components/Hero.astro";
import Education from "../components/Education.astro";
import Footer from "../components/Footer.astro";
import Projects from "../components/Projects.astro";
// import ScrollIndicator from "../components/ScrollIndicator.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <link rel="canonical" href="https://tarangjanawalkar.com/" />
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />

    <!-- Primary -->
    <title>Tarang Janawalkar | Official Website</title>
    <meta name="title" content="Tarang Janawalkar | Official Website" />
    <meta
      name="description"
      content="Software engineer and applied mathematician specialising in full-stack development, cloud infrastructure, embedded systems, and scientific computing. Queensland University of Technology University Medal recipient 2025."
    />
    <meta name="author" content="Tarang Janawalkar" />

    <!-- Open Graph -->
    <meta property="og:title" content="Tarang Janawalkar | Official Website" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://tarangjanawalkar.com/" />
    <meta
      property="og:site_name"
      content="Tarang Janawalkar | Official Website"
    />
    <meta
      property="og:image"
      content="https://tarangjanawalkar.com/preview-image.jpg"
    />
    <meta
      property="og:description"
      content="Software engineer and applied mathematician specialising in full-stack development, cloud infrastructure, embedded systems, and scientific computing. Queensland University of Technology University Medal recipient 2025."
    />
    <meta property="og:locale" content="en_AU" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <main>
      <Hero />
      <Projects />
      <Education />
    </main>
    <footer>
      <Footer />
    </footer>

    <script>
      import Lenis from "lenis";
      import "lenis/dist/lenis.css";

      const lenis = new Lenis({
        duration: 1.5,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -8 * t)),
        smoothWheel: true,
        wheelMultiplier: 1.2,
        touchMultiplier: 1.2,
      });

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }

      requestAnimationFrame(raf);
    </script>
  </body>
</html>
